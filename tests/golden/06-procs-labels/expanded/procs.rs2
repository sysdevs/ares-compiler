[proc,minmax](int $min, int $max, int $value)(int)
if ($max <= $min) {
    $min, $max = $max, $min;
}
if ($value < $min) {
    return($min);
}
if ($value > $max) {
    return($max);
}
return($value);

[proc,swap](int $a, string $b)(string, int)
return($b, $a);

[proc,tuples]
def_string $s;
def_int $i;
$s, $i = ~swap(1, "one");
mes($s);

[label,done](int $code)
mes(tostring($code));

[label,loop](int $n)
if ($n > 0) {
    @loop(calc($n - 1));
}
@done($n);

[proc,caller]
def_int $r = ~minmax(0, 10, 15);
~tuples;

[label,start]
~caller;
@loop(3);
